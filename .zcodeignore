# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc
/components
/resources
/aot
dist

# dependencies
**/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# tool caches
.eslintcache
.prettier-cache
.stylelintcache
**/.cache/

# misc
/.sass-cache
/connect.lock
/coverage
coverage/
**/coverage/
/libpeerconnection.log
npm-debug.log
testem.log
/typings
.angular
TEST.md

# e2e
/e2e/*.js
/e2e/*.map

# System Files
.DS_Store
**/.DS_Store
Thumbs.db

# type doc
api-generator/typedoc.json
api-generator/themedoc.json
.vercel
.nx

# primeng packages
packages/sparkng/src/package.json
# generated by sparkng-themes build scripts
packages/sparkng-themes/tokens
packages/sparkng-themes/umd

# schematics build output
packages/sparkng/schematics/dist
# temp fixture written by the schematics ESM-scope regression test
packages/sparkng/schematics/.esm-scope-fixture
# generated by build-schematics.mjs from the workspace package versions
packages/sparkng/schematics/utils/versions.json
# vitest browser-mode failure artifacts
.vitest-attachments
__screenshots__

# junit test reports
reports

# generated docs content (apps/docs) — regenerated by `pnpm run build` via
# build:docs:content (build:apidoc, build:democode, build:llm-docs,
# build:routes, build:sitemap). Committing these caused stale/conflicting
# diffs on PRs; they are produced fresh on every build/deploy instead.
apps/docs/doc/apidoc
apps/docs/api-generator/typedoc.json
apps/docs/router/routes.txt
apps/docs/public/sitemap.xml
apps/docs/public/llms
apps/docs/public/demos.json

