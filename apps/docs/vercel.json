{
    "version": 2,
    "name": "docs",
    "framework": null,
    "installCommand": "pnpm install --frozen-lockfile",
    "buildCommand": "pnpm build",
    "outputDirectory": "dist/docs/browser",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ],
    "functions": {
        "api/index.mjs": {
            "includeFiles": "dist/docs/**",
            "memory": 1024
        }
    },
    "git": {
        "deploymentEnabled": {
            "main": true,
            "release/1.x": true
        }
    }
}
